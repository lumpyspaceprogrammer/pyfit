# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=pyfit_db
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# AI Vision API (for image analysis)
# Option 1: Using Hugging Face API (Free tier available)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Option 2: Using OpenAI Vision (Recommended but requires payment)
OPENAI_API_KEY=your_openai_api_key

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Pattern Generation Configuration
# These control the sewing pattern output
SEAM_ALLOWANCE_CM=1.5
PATTERN_SCALE=1.0
